{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--caps=devtools",
        "--headless",
        "--browser=chromium"
      ]
    },
    "adrs4ai": {
      "command": "npx",
      "args": [
        "-y",
        "@adrs4ai/mcp",
        "."
      ]
    }
  }
}
