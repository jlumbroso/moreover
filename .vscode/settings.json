{
    // ADR Manager: in-repo (committed) override turning diagnostic
    // logging on for this workspace (2026-08-25, "set it everywhere" —
    // same override as HQ and every other subproject).
    "adrManager.logging.observations": true,
    "adrManager.logging.panelErrors": true,
    "adrManager.logging.tourUnresolvedRefs": true,
    "adrManager.reportButton.enabled": true,
    "adrManager.humanName": "Jérémie Lumbroso",
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#813247",
        "activityBar.background": "#813247",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#4c8a35",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#813247",
        "statusBar.background": "#5c2433",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#813247",
        "statusBarItem.remoteBackground": "#40732d",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#5c2433",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#5c243399",
        "titleBar.inactiveForeground": "#e7e7e799",
        "activityBar.activeBorder": "#e7e7e7",
        "activityBarTop.activeBackground": "#813247",
        "activityBarTop.activeBorder": "#e7e7e7",
        "activityBarTop.background": "#813247",
        "activityBarTop.foreground": "#e7e7e7",
        "activityBarTop.inactiveForeground": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "statusBar.border": "#5c2433",
        "statusBar.debuggingBackground": "#5c2433",
        "statusBar.debuggingForeground": "#e7e7e7",
        "titleBar.border": "#5c2433",
        "statusBar.inactiveBackground": "#5c2433"
    },
    "peacock.color": "#5C2433",
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.env.osx": {
        "PATH": "/opt/homebrew/bin:${env:HOME}/.asdf/shims:${env:PATH}",
        "ANTHROPIC_MODEL": "claude-sonnet-4-6[1m]"
    },
    /* Claude Code configuration */
    "claudeCode.selectedModel": "claude-sonnet-4-6[1m]",
    "claudeCode.environmentVariables": [
        {
            "name": "PATH",
            "value": "/opt/homebrew/bin:${env:HOME}/.asdf/shims:${env:HOME}/.poetry/bin:${env:HOME}/.local/bin:/opt/homebrew/Caskroom/mambaforge/base/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        },
        {
            "name": "ASDF_DIR",
            "value": "/opt/homebrew/opt/asdf/libexec"
        },
        {
            "name": "NODE_PATH",
            "value": "/opt/homebrew/lib/node_modules"
        },
        {
            "name": "ANTHROPIC_MODEL",
            "value": "claude-sonnet-4-6[1m]"
        }
    ],
    // Terminal configuration
    // Core VSCode integrations
    "terminal.integrated.shellIntegration.enabled": false,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.smoothScrolling": false,
    // Links and detection
    "terminal.integrated.enableFileLinks": "on",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    // Suggestions and autocomplete
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.sendKeybindingsToShell": false,
    // Tabs and UI
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.hideCondition": "never",
    "terminal.integrated.tabs.showActions": "never", // no split/kill buttons on tabs on hover
    "terminal.integrated.tabs.enableAnimation": false, // no animation in tab titles
    "terminal.integrated.tabs.title": "${sequence}", // tmux/OSC-0 title sequences drive the tab label (session-continuity: just launch/wake)
    // Persistence
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    // Environment tracking
    "terminal.integrated.environmentChangesIndicator": "off",
    "terminal.integrated.environmentChangesRelaunch": false,
    // Rendering optimizations
    "terminal.integrated.fontLigatures": false,
    "terminal.integrated.cursorBlinking": false,
    "terminal.integrated.cursorSmoothCaretAnimation": "off",
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.drawBoldTextInBrightColors": false,
    // Accessibility (if you don't need it)
    "terminal.integrated.accessibleViewPreserveCursorPosition": false,
    // Copilot
    "github.copilot.editor.enableAutoCompletions": false,
    "github.copilot.chat.terminalContext": "off",
    "github.copilot.enable": {
        "*": true,
        "terminal": false
    },
    "editor.hover.enabled": "off", // Avoid hover messages, especially in terminal
    "workbench.hover.enabled": false,
    "terminal.integrated.showLinkHover": false,
    "terminal.integrated.hover.enabled": false,
    "debug.inlineValues": "off",
    "editor.hover.above": false
}